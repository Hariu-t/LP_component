# Copy to .env.local for local development.
# Also set these in Netlify: Site configuration → Environment variables
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Comma-separated emails that may sign in and become admin on first login.
# Google OAuth Client ID/Secret are configured in Supabase Dashboard → Auth → Providers → Google
# (not in this env file).
NEXT_PUBLIC_ALLOWED_EMAILS=you@example.com
